{
  "name": "sun-sim",
  "version": "0.1.14",
  "description": "Interactive web application for visualizing sun position, sunrise/sunset times, and solar paths",
  "scripts": {
    "test": "node scripts/test.js",
    "test:performance": "node scripts/test.js tests/performance.spec.js",
    "test:headed": "node scripts/test.js --headed",
    "test:debug": "node scripts/test.js --debug",
    "test:install": "node node_modules/@playwright/test/cli.js install"
  },
  "keywords": [
    "sun",
    "solar",
    "astronomy",
    "sunrise",
    "sunset",
    "visualization"
  ],
  "author": "jedarden",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
